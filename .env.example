# Copy this file to a new file named ".env" and fill in your real values.
# .env is git-ignored -- .env.example is safe to commit since it has no real secrets.

# Required. Get free keys at https://console.groq.com/keys
# You can add more than one, separated by commas, to increase your daily quota:
# GROQ_API_KEYS=gsk_key_one,gsk_key_two
GROQ_API_KEYS=

# Optional. Leave blank to use the default.
JARVIS_MODEL=openai/gpt-oss-120b

# Optional -- Telegram integration. Get credentials at https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Optional -- Weather skill. Get a free key at https://openweathermap.org/api
WEATHER_API_KEY=
FLASK_SECRET_KEY=
JARVIS_PASSWORD=
